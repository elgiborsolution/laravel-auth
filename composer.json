{
    "name": "elgibor-solution/laravel-authentication",
    "description": "A standalone authentication package using Laravel Passport and Spatie Permission.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Developer",
            "email": "dev@elgibor-solution.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "laravel/passport": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ElgiborSolution\\Authentication\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElgiborSolution\\Authentication\\Providers\\AuthenticationServiceProvider"
            ]
        }
    }
}
